<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <package android:name="in.swiggy.android" />
        <package android:name="in.swiggy.android.toing" />
        <package android:name="com.application.zomato" />
        <package android:name="com.grofers.customerapp" />
        <package android:name="com.zeptoconsumerapp" />
        <package android:name="com.jpl.jiomart" />
        <package android:name="com.jio.jiomart" />
        <package android:name="com.done.corp" />
        <package android:name="com.bigbasket.mobileapp" />
        <package android:name="com.flipkart.android" />
        <package android:name="com.amazon.mShop.android.shopping" />
    </queries>

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="TuTu Tracker"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DeliveryTracker">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".DeliveryNotificationListenerService"
            android:exported="true"
            android:label="TuTu Notification Reader"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>

</manifest>
